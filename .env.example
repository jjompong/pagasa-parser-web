# Parser ownership and runtime
PPW_OWNER=your-email@example.com
PAGASA_PARSER_TABULA_TIMEOUT_MS=45000

# Immutable image tag or digest shown in operational alerts.
PARSER_IMAGE_REF=ghcr.io/jjompong/pagasa-parser-web:replace-with-release-tag-or-digest

# Discord incoming webhook for the dedicated Maybagyoba production alert channel.
# Keep real values only in the production environment; never commit a webhook URL.
ALERT_WEBHOOK_URL=

# Paul's numeric Discord user ID. Alerts mention this user after 60 minutes.
PAUL_DISCORD_USER_ID=
